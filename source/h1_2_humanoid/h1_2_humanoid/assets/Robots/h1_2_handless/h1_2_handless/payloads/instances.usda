    def Xform "pelvis" (
        prepend references = @./geometries.usd@</Geometries/pelvis>
    )
    {
        over "pelvis" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/pelvis/VisualMaterials/material_1>
        }

        def Scope "VisualMaterials"
        {
            def Material "material_1" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/material_1>
            )
            {
            }
        }
    }

    def Xform "pelvis_1" (
        prepend references = @./geometries.usd@</Geometries/pelvis>
